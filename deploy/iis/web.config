<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS (ARR + URL Rewrite) → Go апп (127.0.0.1:8080) reverse proxy.
  IIS-ийн "surgalt" сайтын физик зам нь энэ хавтас. Let's Encrypt гэрчилгээг
  win-acme авч, автоматаар сунгана (.well-known/acme-challenge-ийг IIS өөрөө үйлчилнэ).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="acme-challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <rule name="www-to-apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.surgalt\.mn$" />
          </conditions>
          <action type="Redirect" url="https://surgalt.mn{UNENCODED_URL}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="http-to-https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^surgalt\.mn$" />
          </conditions>
          <action type="Redirect" url="https://surgalt.mn{UNENCODED_URL}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="proxy-to-go" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="{proto:{HTTPS}}" />
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8080{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
      <outboundRules>
        <!-- ARR/ASP.NET хувилбарыг гадагш ил гаргахгүй -->
        <rule name="hide-x-powered-by">
          <match serverVariable="RESPONSE_X-POWERED-BY" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
      <rewriteMaps>
        <rewriteMap name="proto" defaultValue="http">
          <add key="on" value="https" />
        </rewriteMap>
      </rewriteMaps>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- HSTS: зөвхөн surgalt.mn (бусад дэд домэйн http хэвээр тул includeSubDomains-гүй) -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    <webSocket enabled="true" />
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering allowDoubleEscaping="true" removeServerHeader="true">
        <!-- MAX_FILE_MB=2048 файл хуулахад (байтаар, дээд хязгаар ~4GB) -->
        <requestLimits maxAllowedContentLength="4294967295" maxUrl="8192" maxQueryString="8192" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
