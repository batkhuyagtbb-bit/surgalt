# ---- заавал ----
TOKEN_SECRET=солих-32-тэмдэгтээс-урт-санамсаргүй-мөр
PUBLIC_URL=https://surgalt.mn
WEBHOOK_SECRET=төлбөрийн-үйлчилгээний-webhook-нууц

# ---- нэвтрэлт (хоосон бол товч харагдахгүй) ----
# Callback: {PUBLIC_URL}/auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Google Meet: GOOGLE_CLIENT_* -г ашиглана, нэмэлт callback: {PUBLIC_URL}/auth/google-meet/callback

# ---- файлын сан ----
STORAGE_FREE_MB=300
# MB:₮/сар — 300MB, 500MB, 1GB, 2GB, 5GB
STORAGE_PLANS=300:5000,500:8000,1024:14000,2048:25000,5120:55000
MAX_FILE_MB=2048
VIDEO_WORKERS=1

# ---- бусад ----
RATE_LIMIT_RPS=30
RATE_BURST=60
# ClickHouse (docker compose өөрөө дамжуулна; гадны сервер бол энд бичнэ)
# CLICKHOUSE_DSN=clickhouse://user:pass@host:9000/surgalt
CLICKHOUSE_PASSWORD=surgalt
# Олон app хуулбар ажиллуулахад ЗААВАЛ: ClickHouse Keeper (түгжээ + чатын түгээлт). docker compose өөрөө дамжуулна.
# CLICKHOUSE_KEEPER=host:9181
# gRPC API (Protobuf) — мобайл/сервис хоорондын харилцаанд. Хоосон бол асахгүй.
GRPC_ADDR=:9090
DEV_PAYMENTS=0
SEED_DEMO=0
LOG_REQUESTS=0
