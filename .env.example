# ---- заавал ----
TOKEN_SECRET=солих-32-тэмдэгтээс-урт-санамсаргүй-мөр
PUBLIC_URL=https://surgalt.mn
WEBHOOK_SECRET=төлбөрийн-үйлчилгээний-webhook-нууц

# ---- нэвтрэлт (хоосон бол товч харагдахгүй) ----
# Callback: {PUBLIC_URL}/auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Google Meet: GOOGLE_CLIENT_* -г ашиглана, нэмэлт callback: {PUBLIC_URL}/auth/google-meet/callback

# ---- QPay QR төлбөр (хоосон бол DEV_PAYMENTS=1 үед демо QR) ----
# QPay-ээс авсан merchant эрх. Төлбөр орсныг {PUBLIC_URL}/api/payments/qpay руу мэдэгдэнэ.
# Туршилт (sandbox): QPAY_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_URL=

# ---- файлын сан ----
STORAGE_FREE_MB=300
# MB:₮/сар — 300MB, 500MB, 1GB, 2GB, 5GB
STORAGE_PLANS=300:5000,500:8000,1024:14000,2048:25000,5120:55000
MAX_FILE_MB=2048
VIDEO_WORKERS=1

# ---- бусад ----
# ---- имэйл (нууц үг сэргээх) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=таны@gmail.com,
#   SMTP_PASS=«App password» (Google аккаунт → Аюулгүй байдал → 2 шаттай баталгаажуулалт → App passwords).
# Домэйн имэйл (no-reply@surgalt.mn г.м.) бол хостинг/имэйл үйлчилгээний SMTP мэдээллийг бичнэ. 465 порт = шууд TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Илгээгч (хоосон бол SMTP_USER). Жишээ: surgalt.mn <no-reply@surgalt.mn>
SMTP_FROM=

# Багшийн орлого татах доод дүн (₮). Татах хүсэлтийг хянагч (ADMIN_EMAILS) /admin-аас шилжүүлсэн гэж тэмдэглэнэ.
PAYOUT_MIN=1000

# Төлбөр бүрийн үнэ дээр нэмж авах үйлчилгээний хураамж (%). Суралцагч үнэ + хураамжийг төлнө, багш үнээ бүтнээр авна.
SERVICE_FEE_PERCENT=1
# Багшийн борлуулалтаас платформын авах шимтгэл (%): багшийн «Татах боломжтой» дүнгээс хасагдана.
TEACHER_COMMISSION_PERCENT=21

# Нууцлалын бодлого, үйлчилгээний нөхцөлийн хуудсанд харагдах холбоо барих имэйл (/privacy, /terms)
CONTACT_EMAIL=
# Чатын мэдүүлэг шийдвэрлэх хянагчид (/admin), таслалаар. Google/Microsoft-оор нэвтэрсэн бүртгэл байна
# (нууц үгтэй бүртгэл хянагч болохгүй — бусад хүн тэр имэйлээр түрүүлж бүртгүүлэхээс сэргийлнэ).
ADMIN_EMAILS=
# Хянагчийн самбар: тусдаа (холбоосгүй) зам ба нууц үгээр нэвтрэх. ADMIN_PATH хоосон бол /admin.
# Нууц үгийн hash-ийг: echo "<нууц үг>" | surgalt.exe hash-password  (12+ тэмдэгт). Нууц үгээ өөрийг нь энд бичихгүй.
ADMIN_PATH=
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
RATE_LIMIT_RPS=30
RATE_BURST=60
# ClickHouse (docker compose өөрөө дамжуулна; гадны сервер бол энд бичнэ)
# CLICKHOUSE_DSN=clickhouse://user:pass@host:9000/surgalt
# TLS-тэй гадны сервер (9440): DSN-д ?secure=true, өөрийн CA-аар гаргасан сертификатыг шалгах PEM файл:
# CLICKHOUSE_DSN=clickhouse://app_user:pass@host:9440/appdb?secure=true&dial_timeout=10s
# CLICKHOUSE_CA=./clickhouse-ca.crt
CLICKHOUSE_PASSWORD=surgalt
# Олон app хуулбар ажиллуулахад ЗААВАЛ: ClickHouse Keeper (түгжээ + чатын түгээлт). docker compose өөрөө дамжуулна.
# CLICKHOUSE_KEEPER=host:9181
# gRPC API (Protobuf) — мобайл/сервис хоорондын харилцаанд. Хоосон бол асахгүй.
GRPC_ADDR=:9090
DEV_PAYMENTS=0
SEED_DEMO=0
LOG_REQUESTS=0
